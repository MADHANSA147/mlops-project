# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DB_NAME=aipi_db

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Reddit API (create app at https://www.reddit.com/prefs/apps) ─
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AIPI/1.0

# ── Reddit Subreddits to monitor (comma-separated) ──────────────
REDDIT_SUBREDDITS=news,worldnews,technology,politics,science,business

# ── MLflow ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── Model ────────────────────────────────────────────────────────
MODEL_PATH=./ml/artifacts

# ── Scheduler ────────────────────────────────────────────────────
SCHEDULER_INTERVAL_MINUTES=5

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
